  "components": {
    "schemas": {
      "ApplyRequest": {
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "predictive",
              "first_fit",
              "best_fit",
              "static"
            ],
            "title": "Strategy",
            "default": "predictive"
          },
          "interval_minutes": {
            "type": "number",
            "maximum": 1440.0,
            "exclusiveMinimum": 0.0,
            "title": "Interval Minutes",
            "default": 5
          },
          "energy_weight": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Energy Weight",
            "default": 1
          },
          "risk_weight": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Risk Weight",
            "default": 2
          },
          "balance_weight": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Balance Weight",
            "default": 0.15
          },
          "migration_weight": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Migration Weight",
            "default": 0.4
          },
          "headroom": {
            "type": "number",
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Headroom",
            "default": 0.1
          },
          "cooldown_intervals": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Cooldown Intervals",
            "default": 2
          },
          "minimum_improvement": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Minimum Improvement",
            "default": 0.002
          },
          "idle_watts": {
            "type": "number",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Idle Watts",
            "default": 100
          },
          "peak_watts": {
            "type": "number",
            "maximum": 20000.0,
            "exclusiveMinimum": 0.0,
            "title": "Peak Watts",
            "default": 250
          },
          "sleep_watts": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Sleep Watts",
            "default": 5
          },
          "migration_wh_per_gb": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Migration Wh Per Gb",
            "default": 0.05
          },
          "beam_width": {
            "type": "integer",
            "maximum": 128.0,
            "minimum": 1.0,
            "title": "Beam Width",
            "default": 32
          },
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision"
          },
          "allocation": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Allocation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "allocation"
        ],
        "title": "ApplyRequest"
      },
      "EnergyInput": {
        "properties": {
          "cpu_mean": {
            "type": "number",
            "minimum": 0.0,
            "title": "Cpu Mean"
          },
          "cpu_max": {
            "type": "number",
            "minimum": 0.0,
            "title": "Cpu Max"
          },
          "cpu_min": {
            "type": "number",
            "minimum": 0.0,
            "title": "Cpu Min"
          },
          "cpu_std": {
            "type": "number",
            "minimum": 0.0,
            "title": "Cpu Std"
          },
          "cpu_median": {
            "type": "number",
            "minimum": 0.0,
            "title": "Cpu Median"
          },
          "cpu_frequency_ghz": {
            "type": "number",
            "minimum": 0.0,
            "title": "Cpu Frequency Ghz"
          },
          "memory_util_gb": {
            "type": "number",
            "minimum": 0.0,
            "title": "Memory Util Gb"
          },
          "sda_write_count_during_interval": {
            "type": "number",
            "minimum": 0.0,
            "title": "Sda Write Count During Interval"
          },
          "sda_read_count_during_interval": {
            "type": "number",
            "minimum": 0.0,
            "title": "Sda Read Count During Interval"
          }
        },
        "type": "object",
        "required": [
          "cpu_mean",
          "cpu_max",
          "cpu_min",
          "cpu_std",
          "cpu_median",
          "cpu_frequency_ghz",
          "memory_util_gb",
          "sda_write_count_during_interval",
          "sda_read_count_during_interval"
        ],
        "title": "EnergyInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Histories": {
        "properties": {
          "histories": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/ResourceData"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Histories"
          },
          "source": {
            "type": "string",
            "pattern": "^(user-entered|measured|synthetic)$",
            "title": "Source",
            "default": "user-entered"
          }
        },
        "type": "object",
        "required": [
          "histories"
        ],
        "title": "Histories"
      },
      "MetricResponse": {
        "properties": {
          "total_energy_wh": {
            "type": "number",
            "title": "Total Energy Wh"
          },
          "energy_wh": {
            "type": "number",
            "title": "Energy Wh"
          },
          "migration_energy_wh": {
            "type": "number",
            "title": "Migration Energy Wh"
          },
          "power_w": {
            "type": "number",
            "title": "Power W"
          },
          "sla_pressure_proxy": {
            "type": "number",
            "title": "Sla Pressure Proxy"
          },
          "scheduled_vms": {
            "type": "integer",
            "title": "Scheduled Vms"
          },
          "migrations": {
            "type": "integer",
            "title": "Migrations"
          },
          "servers": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Servers"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "total_energy_wh",
          "energy_wh",
          "migration_energy_wh",
          "power_w",
          "sla_pressure_proxy",
          "scheduled_vms",
          "migrations",
          "servers"
        ],
        "title": "MetricResponse"
      },
      "MutationResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "state": {
            "$ref": "#/components/schemas/Snapshot"
          }
        },
        "type": "object",
        "required": [
          "success",
          "state"
        ],
        "title": "MutationResponse"
      },
      "OptimizationInput": {
        "properties": {
          "current_cpu": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Current Cpu"
          },
          "predicted_workload": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Predicted Workload"
          },
          "cpu_frequency_ghz": {
            "type": "number",
            "minimum": 0.0,
            "title": "Cpu Frequency Ghz"
          },
          "memory_util_gb": {
            "type": "number",
            "minimum": 0.0,
            "title": "Memory Util Gb"
          },
          "sda_write_count_during_interval": {
            "type": "number",
            "minimum": 0.0,
            "title": "Sda Write Count During Interval"
          },
          "sda_read_count_during_interval": {
            "type": "number",
            "minimum": 0.0,
            "title": "Sda Read Count During Interval"
          }
        },
        "type": "object",
        "required": [
          "current_cpu",
          "predicted_workload",
          "cpu_frequency_ghz",
          "memory_util_gb",
          "sda_write_count_during_interval",
          "sda_read_count_during_interval"
        ],
        "title": "OptimizationInput"
      },
      "Options": {
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "predictive",
              "first_fit",
              "best_fit",
              "static"
            ],
            "title": "Strategy",
            "default": "predictive"
          },
          "interval_minutes": {
            "type": "number",
            "maximum": 1440.0,
            "exclusiveMinimum": 0.0,
            "title": "Interval Minutes",
            "default": 5
          },
